{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "web_src",
    "outDir": "web_content",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["web_src/**/*.ts"]
}
